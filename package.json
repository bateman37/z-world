{
  "name": "z-world",
  "private": true,
  "version": "0.1.0",
  "description": "Z-World — laboratorio de simulación web (línea activa Node.js/TypeScript/Next.js/PostgreSQL).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate --workspace packages/persistence",
    "db:generate": "npm run db:generate --workspace packages/persistence"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "20.16.11",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "eslint": "8.57.1",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
